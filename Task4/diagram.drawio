        <mxCell id="n47" value="&lt;b&gt;Выход (outputs.tf):&lt;/b&gt; публичный IP бастиона, внутренние адреса узлов, имя бакета, идентификатор ключа S3, адрес портала." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1160" y="706" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n48" value="Легенда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9AA0A6;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#444444;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="1030" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n49" value="Управляется Terraform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE3F7;strokeColor=#7B42BC;fontColor=#35185C;arcSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="1065" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n50" value="Разворачивается вручную" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DE;strokeColor=#D97706;fontColor=#6B3A00;arcSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="1065" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n51" value="Настраивается после apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2E6;strokeColor=#3F8F4B;fontColor=#1E4A26;arcSize=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="1065" width="210" height="45" as="geometry" />
        </mxCell>
        <mxCell id="n52" value="&lt;b&gt;Порядок создания внутри контура Terraform не задаётся вручную.&lt;/b&gt; Terraform строит граф зависимостей по ссылкам между ресурсами: подсеть не создастся раньше сети, виртуальная машина — раньше подсети и диска, балансировщик — раньше машины портала.&lt;br&gt;&lt;br&gt;&lt;b&gt;NAT.&lt;/b&gt; Публичный адрес (&lt;i&gt;nat = true&lt;/i&gt;) есть только у бастиона. Остальные узлы выходят в интернет через NAT-шлюз по маршруту 0.0.0.0/0 и снаружи недоступны — входящие соединения к ним невозможны.&lt;br&gt;&lt;br&gt;&lt;b&gt;Команды:&lt;/b&gt; terraform init → terraform plan → terraform apply." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1030" width="300" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
